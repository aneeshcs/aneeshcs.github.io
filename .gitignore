# ============================================================================
# Hugo Site .gitignore
# ============================================================================

# ============================================================================
# Hugo Build Artifacts
# ============================================================================

# Generated site output
public/

# Hugo resources (processed assets)
resources/

# Hugo build lock
.hugo_build.lock

# Hugo stats
hugo_stats.json

# marimo local session/layout artifacts
**/__marimo__/

# Auto-generated JS config
**/assets/jsconfig.json

# ============================================================================
# Node.js & Package Managers
# ============================================================================

# Dependencies
node_modules/

# ============================================================================
# Environment & Configuration
# ============================================================================

# Environment variables
.env
.env.local
.env.*.local

# ============================================================================
# Generated Content
# ============================================================================

# Pagefind search index
pagefind/
static/pagefind/

# marimo WASM exports — deploy.yml regenerates these from notebooks/ on every
# push, so committing them stored a second, immediately-stale copy (~56 MB, and
# every re-export rewrites all of it because the JS chunk names are content
# hashes). Run `uvx marimo export html-wasm ...` locally if you need them in a
# local preview; see the "Export marimo notebooks" step in deploy.yml.
static/chaos/
static/da_tutorial/

# ============================================================================
# Operating System
# ============================================================================

# macOS
.DS_Store
.DS_Store?
._*

# Windows
Thumbs.db
Desktop.ini

# Linux
*~

# ============================================================================
# Logs & Temporary Files
# ============================================================================

*.log
npm-debug.log*

# Claude Code local working directory (agent worktrees, settings)
.claude/
